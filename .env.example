# Salin ke .env, lalu isi kedua password dengan nilai lokal masing-masing.
DB_PASSWORD=ganti_password_aplikasi
MYSQL_ROOT_PASSWORD=ganti_password_root
DB_PORT=3307
# Port 8080 sudah digunakan proyek Docker lain di komputer ini.
PORT=8081
# Origin React lokal yang boleh mengirim cookie sesi.
FRONTEND_ORIGIN=http://localhost:5173
# Wajib true saat aplikasi benar-benar dijalankan melalui HTTPS.
SESSION_COOKIE_SECURE=false
